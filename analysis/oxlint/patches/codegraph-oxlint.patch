+pub fn discover_journal(
+    mut request: DiscoverRequest,
+) -> Result<(Value, Option<MembershipOwner>), String> {
+    if request.operation != "discover-journal"
+        || !request.observations.is_empty()
+        || request.observation_frame.is_some()
+    {
+        return Err("journal owner forbids client observations or frames".into());
+    }
+    request.operation = "discover".into();
+    let capture = Arc::new(JournalCapture {
+        capture: Mutex::new(Capture::admit(vec![])?),
+        go_owner: None,
+        failure: Mutex::new(None),
+        partial: Mutex::new(vec![]),
+    });
+    let (mut output, owner) = discover_with_capture(request, capture.clone())?;
+    output["prototypeJournal"] = json!(capture.journal());
+    Ok((output, owner))
+}
