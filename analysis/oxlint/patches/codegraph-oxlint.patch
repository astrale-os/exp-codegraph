+#![expect(clippy::print_stdout)]
+//! Local protocol experiment: the original linter and JSON reporter consume
+//! only source bytes supplied by the owner of a captured generation.
+use std::{
+    collections::HashMap,
+    ffi::OsStr,
+    io::{self, Write},
+    path::{Path, PathBuf},
+    sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+        mpsc,
+    },
+    time::Instant,
+};
+
+use oxc_allocator::Allocator;
+use oxc_diagnostics::JSONReportHandler;
+use oxc_linter::{
+    ConfigStore, ConfigStoreBuilder, ExternalPluginStore, LintOptions, LintService,
+    LintServiceOptions, Linter, Oxlintrc, RuntimeFileSystem,
+};
+use serde::Deserialize;
+use serde_json::{Value, json};
+#[path = "captured/authority.rs"]
+mod authority;
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Request {
+    operation: Option<String>,
+    token: Option<String>,
+    root: PathBuf,
+    config_path: PathBuf,
+    config: Option<Value>,
+    config_bytes: Option<Vec<u8>>,
+    files: Vec<InputFile>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct InputFile {
+    path: PathBuf,
+    content: Option<String>,
+    handle: Option<u64>,
+}
+
+struct CapturedFileSystem {
+    files: HashMap<PathBuf, Arc<str>>,
+    reads: AtomicUsize,
+}
+
+impl RuntimeFileSystem for CapturedFileSystem {
+    fn read_to_arena_str<'a>(&self, path: &Path, allocator: &'a Allocator) -> io::Result<&'a str> {
+        self.reads.fetch_add(1, Ordering::Relaxed);
+        let source = self.files.get(path).ok_or_else(|| {
+            io::Error::new(io::ErrorKind::NotFound, "source is outside the captured input domain")
+        })?;
+        Ok(allocator.alloc_str(source))
+    }
+
+    fn write_file(&self, _path: &Path, _content: &str) -> io::Result<()> {
+        Err(io::Error::new(io::ErrorKind::PermissionDenied, "captured lint input is immutable"))
+    }
+}
+
+#[derive(Default)]
+struct Worker {
+    roots: HashMap<PathBuf, RootCache>,
+    memberships: HashMap<String, authority::MembershipOwner>,
+    discovery_frames: authority::DiscoveryFrames,
+    suspended_discovery: authority::SuspendedDiscovery,
+    next_handle: u64,
+}
+
+#[derive(Default)]
+struct RootCache {
+    config: Option<(PathBuf, Value)>,
+    files: HashMap<PathBuf, OwnedFile>,
+}
+
+struct OwnedFile {
+    handle: u64,
+    source: Arc<str>,
+    diagnostics: Vec<Value>,
+}
+
+fn parse_configuration(
+    path: &Path,
+    data: Option<Value>,
+    bytes: Option<Vec<u8>>,
+) -> Result<(Oxlintrc, Value), String> {
+    if !path.is_absolute() {
+        return Err("configuration identity must be absolute".into());
+    }
+    let (mut config, config_input) = match (data, bytes) {
+        (Some(value), None) => {
+            let parsed = serde_json::from_value(value.clone()).map_err(|e| e.to_string())?;
+            (parsed, value)
+        }
+        (None, Some(bytes)) => {
+            let parsed =
+                Oxlintrc::from_captured_bytes(path, bytes.clone()).map_err(|e| e.to_string())?;
+            (parsed, json!({"capturedConfigBytes": bytes}))
+        }
+        _ => {
+            return Err("supply either admitted preset data or captured configuration bytes".into());
+        }
+    };
+    config.path = path.to_path_buf();
+    config.set_config_dir(path.parent().unwrap());
+    Ok((config, config_input))
+}
+
+fn admit_configuration(config: &Oxlintrc) -> Result<(), String> {
+    if !config.extends.is_empty() || config.external_plugins.as_ref().is_some_and(|p| !p.is_empty())
+    {
+        return Err("this experiment has no owner for extended configurations or JS plugins".into());
+    }
+    if config.options.type_aware == Some(true) || config.options.type_check == Some(true) {
+        return Err("this experiment has no owner for tsgolint observations".into());
+    }
+    if config.options.report_unused_disable_directives.is_some() {
+        return Err("this experiment has no captured unused-directive report owner".into());
+    }
+    if config.plugins.is_some_and(|p| p.contains(oxc_linter::LintPlugins::IMPORT)) {
+        return Err("this experiment has no captured module-resolution owner".into());
+    }
+    Ok(())
+}
+
+fn lint(worker: &mut Worker, request: Request) -> Result<Value, String> {
+    if request.operation.as_deref().is_some_and(|op| op != "lint") {
+        return Err("unknown captured lint operation".into());
+    }
+    let started = Instant::now();
+    if !request.root.is_absolute() || !request.config_path.is_absolute() {
+        return Err("root and configuration identity must be absolute".into());
+    }
+    let (mut config, config_input) =
+        parse_configuration(&request.config_path, request.config, request.config_bytes)?;
+    admit_configuration(&config)?;
+    config.path = request.config_path.clone();
+    let mut plugins = ExternalPluginStore::default();
+    let configuration =
+        ConfigStoreBuilder::from_closed_captured_oxlintrc(false, config, &mut plugins)
+            .map_err(|e| format!("{e:?}"))?
+            .build(&mut plugins)
+            .map_err(|e| format!("{e:?}"))?;
+    let store = ConfigStore::new(configuration, Default::default(), plugins);
+    if store.plugins().contains(oxc_linter::LintPlugins::IMPORT) {
+        return Err("this experiment has no captured module-resolution owner".into());
+    }
+    let number_of_rules = store.number_of_rules(false);
+    let service = LintService::new(
+        Linter::new(LintOptions::default(), store, None),
+        LintServiceOptions::new(request.root.as_path()),
+    );
+    let cached = worker.roots.get(&request.root);
+    let config_key = (request.config_path.clone(), config_input);
+    if let Some(token) = &request.token {
+        let membership = worker
+            .memberships
+            .get(token)
+            .ok_or("token has no qualified captured generic membership")?;
+        let paths: std::collections::BTreeSet<_> =
+            request.files.iter().map(|f| f.path.clone()).collect();
+        if membership.root != request.root
+            || membership.config_key != config_key
+            || membership.paths != paths
+            || paths.len() != request.files.len()
+        {
+            return Err("tokened lint changed owned root/configuration/membership".into());
+        }
+    }
+    let same_config = cached.is_some_and(|root| root.config.as_ref() == Some(&config_key));
+    let mut all_paths = Vec::new();
+    let mut paths = Vec::<Arc<OsStr>>::new();
+    let mut files = HashMap::new();
+    let mut retained_handles = HashMap::new();
+    let mut cached_diagnostics = HashMap::new();
+    let mut reused = 0;
+    for file in request.files {
+        if !file.path.is_absolute() || files.contains_key(&file.path) {
+            return Err("captured file identities must be absolute and unique".into());
+        }
+        let previous = cached.and_then(|root| root.files.get(&file.path));
+        let source: Arc<str> = match (file.content, file.handle) {
+            (Some(content), None) => Arc::from(content),
+            (None, Some(handle)) => {
+                let owner = previous.filter(|old| old.handle == handle).ok_or(
+                    "captured source handle is unknown, stale, or belongs to another path/root",
+                )?;
+                Arc::clone(&owner.source)
+            }
+            _ => {
+                return Err(
+                    "supply either owned source bytes or a previously issued source handle".into(),
+                );
+            }
+        };
+        let same_source = previous.is_some_and(|old| old.source.as_ref() == source.as_ref());
+        if same_source {
+            let old = previous.unwrap();
+            retained_handles.insert(file.path.clone(), old.handle);
+            if same_config {
+                cached_diagnostics.insert(file.path.clone(), old.diagnostics.clone());
+                reused += 1;
+            }
+        }
+        if !same_source || !same_config {
+            paths.push(Arc::from(file.path.as_os_str()));
+        }
+        all_paths.push(file.path.clone());
+        files.insert(file.path, source);
+    }
+    let number_of_files = all_paths.len();
+    let evaluated_files = paths.len();
+    let file_system = CapturedFileSystem { files, reads: AtomicUsize::new(0) };
+    let (sender, receiver) = mpsc::channel();
+    service.run_captured_sources(&file_system, paths, &sender);
+    drop(sender);
+    let handler = JSONReportHandler::new();
+    let mut fresh_diagnostics: HashMap<PathBuf, Vec<Value>> = HashMap::new();
+    for batch in receiver {
+        for error in batch {
+            let mut rendered = String::new();
+            handler.render_report(&mut rendered, error.as_ref()).map_err(|e| e.to_string())?;
+            let diagnostic = serde_json::from_str::<Value>(&rendered).map_err(|e| e.to_string())?;
+            let filename = diagnostic
+                .get("filename")
+                .and_then(Value::as_str)
+                .ok_or("diagnostic has no captured source identity; cannot cache its projection")?;
+            let path = request.root.join(filename);
+            if !file_system.files.contains_key(&path) {
+                return Err("diagnostic source is outside the captured input domain".into());
+            }
+            fresh_diagnostics.entry(path).or_default().push(diagnostic);
+        }
+    }
+    let mut diagnostics = Vec::new();
+    let mut handles = Vec::new();
+    let mut published_files = HashMap::new();
+    // Commit only after the whole request has been admitted and evaluated.
+    // Evicted membership cannot subsequently be revived by a stale handle.
+    for path in all_paths {
+        let per_file = cached_diagnostics
+            .remove(&path)
+            .unwrap_or_else(|| fresh_diagnostics.remove(&path).unwrap_or_default());
+        diagnostics.extend(per_file.iter().cloned());
+        let handle = if let Some(handle) = retained_handles.remove(&path) {
+            handle
+        } else {
+            worker.next_handle =
+                worker.next_handle.checked_add(1).ok_or("source handle space exhausted")?;
+            worker.next_handle
+        };
+        handles.push(json!({"path": path, "handle": handle}));
+        published_files.insert(
+            path.clone(),
+            OwnedFile {
+                handle,
+                source: Arc::clone(file_system.files.get(&path).unwrap()),
+                diagnostics: per_file,
+            },
+        );
+    }
+    worker
+        .roots
+        .insert(request.root, RootCache { config: Some(config_key), files: published_files });
+    Ok(json!({
+        "output": {"diagnostics": diagnostics, "number_of_files": number_of_files,
+                   "number_of_rules": number_of_rules},
+        "captureReads": file_system.reads.load(Ordering::Relaxed),
+        "evaluatedFiles": evaluated_files,
+        "reusedDecisions": reused,
+        "fileHandles": handles,
+        "elapsedMs": started.elapsed().as_secs_f64() * 1000.0,
+        "token": request.token,
+        "membershipQualified": request.token.is_some(),
+        "complete": false,
+        "engineVersion": env!("CARGO_PKG_VERSION"),
+        "premises": "Caller supplies admitted generic membership and closed builtin configuration; import resolution, JS plugins, tsgolint and suppression-file baselines are unqualified."
+    }))
+}
+
+fn main() -> io::Result<()> {
+    let stdin = io::stdin();
+    let mut stdout = io::stdout();
+    let mut worker = Worker::default();
+    loop {
+        let mut line = String::new();
+        if stdin.read_line(&mut line)? == 0 {
+            break;
+        }
+        let result =
+            serde_json::from_str::<Value>(&line).map_err(|e| e.to_string()).and_then(|value| {
+                if value.get("operation").and_then(Value::as_str) == Some("discover-owned-batch") {
+                    let request = serde_json::from_value(value).map_err(|e| e.to_string())?;
+                    authority::discover_owned_batch(&mut worker, request)
+                } else if value.get("operation").and_then(Value::as_str)
+                    == Some("discover-owned-lint")
+                {
+                    let request = serde_json::from_value(value).map_err(|e| e.to_string())?;
+                    authority::discover_owned_lint(&mut worker, request)
+                } else if matches!(
+                    value.get("operation").and_then(Value::as_str),
+                    Some("discover" | "discover-suspend" | "discover-journal")
+                ) {
+                    let suspend =
+                        value.get("operation").and_then(Value::as_str) == Some("discover-suspend");
+                    let journal =
+                        value.get("operation").and_then(Value::as_str) == Some("discover-journal");
+                    let request: authority::DiscoverRequest =
+                        serde_json::from_value(value).map_err(|e| e.to_string())?;
+                    let token = request.token.clone();
+                    let (result, membership) = if journal {
+                        authority::discover_journal(request)?
+                    } else if suspend {
+                        worker.suspended_discovery.discover(request)?
+                    } else {
+                        worker.discovery_frames.discover(request)?
+                    };
+                    if let Some(owner) = membership {
+                        worker.memberships.retain(|_, old| old.root != owner.root);
+                        worker.memberships.insert(token, owner);
+                    }
+                    Ok(result)
+                } else {
+                    serde_json::from_value::<Request>(value)
+                        .map_err(|e| e.to_string())
+                        .and_then(|request| lint(&mut worker, request))
+                }
+            });
+        let output = match result {
+            Ok(value) => value,
+            Err(error) => json!({"error": error, "complete": false}),
+        };
+        serde_json::to_writer(&mut stdout, &output)?;
+        writeln!(stdout)?;
+        stdout.flush()?;
+    }
+    Ok(())
