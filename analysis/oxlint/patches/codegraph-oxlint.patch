+impl GenericCapture for JournalCapture {
+    fn directory(&self, path: &Path) -> io::Result<Vec<CapturedDirectoryEntry>> {
+        self.own("directory",path,false,|| {
+            let mut entries=Vec::new();
+            for entry in std::fs::read_dir(path)? {
+                let entry=match entry {Ok(entry)=>entry, Err(error)=>{
+                    self.partial.lock().unwrap().push(json!({"path":path,"entries":entries,"kind":format!("{:?}",error.kind()),"code":error.raw_os_error(),"message":error.to_string()}));
+                    *self.failure.lock().unwrap()=Some("partial native directory enumeration is not bridgeable".into());return Err(error);
+                }};
+                let file_type=match entry.file_type() {Ok(t)=>t,Err(error)=>{
+                    self.partial.lock().unwrap().push(json!({"path":path,"entries":entries,"entry":entry.path(),"kind":format!("{:?}",error.kind()),"code":error.raw_os_error(),"message":error.to_string()}));
+                    *self.failure.lock().unwrap()=Some("native directory entry type is not bridgeable".into());return Err(error);
+                }};
+                let kind=if file_type.is_symlink() {"symlink"} else if file_type.is_dir() {"directory"} else if file_type.is_file() {"file"} else {"other"};
+                let name=entry.file_name().into_string().map_err(|_|io::Error::new(io::ErrorKind::InvalidData,"non UTF8 directory identity"))?;
+                entries.push(json!({"name":name,"kind":kind}));
+            }
+            entries.sort_by(|a,b|a["name"].as_str().cmp(&b["name"].as_str()));Ok(json!({"entries":entries}))
+        },|c|c.directory(path))
+    }
+    fn assert_observations_complete(&self) -> io::Result<()> {
+        if let Some(error) = self.failure.lock().unwrap().as_ref() {
+            return Err(io::Error::new(io::ErrorKind::InvalidData, error.clone()));
+        }
+        self.capture.lock().unwrap().assert_observations_complete()
+    }
+}
+impl ObservationCapture for JournalCapture {
+    fn requirements(&self) -> Vec<Requirement> {
+        vec![]
+    }
