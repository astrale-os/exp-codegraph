@@ -0,0 +1,53 @@
+//! Captured I/O authority for the unchanged hierarchical ignore matcher.
+//! Returning `WouldBlock` denotes an observation not yet admitted by the capture
+//! owner. The owner must collect this requirement and retry on the same capture;
+//! it must never publish a matcher answer while such requirements remain.
+use std::{
+    fmt::Debug,
+    io,
+    path::{Path, PathBuf},
+    sync::Arc,
+};
+
+#[derive(Clone, Copy, Debug)]
+/// Followed or unfollowed metadata admitted by one capture.
+pub struct CapturedMetadata {
+    /// Whether the observed entry is a directory.
+    pub is_dir: bool,
+    /// Whether the observed entry is a regular file.
+    pub is_file: bool,
+    /// Observed file size in bytes.
+    pub len: u64,
+}
+
+/// All operations refer to one immutable captured filesystem. Errors are owned
+/// observations too; a missing table entry must not be turned into `NotFound`.
+pub trait CapturedFileSystem: Debug + Send + Sync {
+    /// Observe followed or unfollowed metadata, including failures.
+    fn metadata(&self, path: &Path, follow_links: bool) -> io::Result<CapturedMetadata>;
+    /// Read admitted bytes; absence and read failures remain distinct.
+    fn read(&self, path: &Path) -> io::Result<Vec<u8>>;
+    /// Resolve the canonical identity using admitted link topology.
+    fn canonicalize(&self, path: &Path) -> io::Result<PathBuf>;
+}
+pub(crate) type Authority = Option<Arc<dyn CapturedFileSystem>>;
+pub(crate) fn metadata(fs: &Authority, path: &Path, follow: bool) -> io::Result<CapturedMetadata> {
+    if let Some(fs) = fs {
+        return fs.metadata(path, follow);
+    }
+    let m = if follow { path.metadata()? } else { path.symlink_metadata()? };
+    Ok(CapturedMetadata { is_dir: m.is_dir(), is_file: m.is_file(), len: m.len() })
+}
+pub(crate) fn exists(fs: &Authority, path: &Path) -> bool {
+    metadata(fs, path, true).is_ok()
+}
+pub(crate) fn canonicalize(fs: &Authority, path: &Path) -> io::Result<PathBuf> {
+    if let Some(fs) = fs { fs.canonicalize(path) } else { path.canonicalize() }
+}
+pub(crate) fn reader(fs: &Authority, path: &Path) -> io::Result<Box<dyn io::BufRead>> {
+    if let Some(fs) = fs {
+        Ok(Box::new(io::Cursor::new(fs.read(path)?)))
+    } else {
+        Ok(Box::new(io::BufReader::new(std::fs::File::open(path)?)))
+    }
+}
