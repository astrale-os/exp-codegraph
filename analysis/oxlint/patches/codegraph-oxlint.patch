+    fn metadata_row(path: &str) -> Value {
+        json!({"requirement":{"id":path,"kind":"metadata","path":path,"followLinks":true},"observation":{"id":path,"status":"known","value":{"isDirectory":true,"isFile":false,"isSymlink":false,"length":0}}})
+    }
+    #[test]
+    fn delta_frame_rejects_duplicate_and_stale_rows_without_mutating_ownership() {
+        let mut frames = DiscoveryFrames::default();
+        let (first, _) = frames.discover(frame_request(None, json!([]))).unwrap();
+        let first_id = first["observationFrame"].as_u64().unwrap();
+        let (second, _) = frames
+            .discover(frame_request(Some(first_id), json!([metadata_row("/captured/domain")])))
+            .unwrap();
+        let second_id = second["observationFrame"].as_u64().unwrap();
+        assert!(second_id > first_id);
+        assert!(frames.discover(frame_request(Some(first_id), json!([]))).is_err());
+        assert!(
+            frames
+                .discover(frame_request(Some(second_id), json!([metadata_row("/captured/domain")])))
+                .is_err()
+        );
+        assert_eq!(frames.current.as_ref().unwrap().id, second_id);
+        assert_eq!(frames.current.as_ref().unwrap().capture.rows.len(), 1);
+    }
+    #[test]
+    fn delta_frame_cannot_change_any_owner_coordinate() {
+        let mut frames = DiscoveryFrames::default();
+        let (first, _) = frames.discover(frame_request(None, json!([]))).unwrap();
+        let id = first["observationFrame"].as_u64().unwrap();
+        for field in ["token", "root", "configPath", "config", "commandIgnorePatterns"] {
+            let mut value = serde_json::to_value(json!({
+                "operation":"discover", "token":"capture", "root":"/captured/domain",
+                "configPath":"/captured/domain/.oxlintrc.json", "config":{"categories":{"correctness":"off"}},
+                "commandIgnorePatterns":[], "observations":[], "observationFrame":id,
+            })).unwrap();
+            value[field] = match field {
+                "config" => json!({}),
+                "commandIgnorePatterns" => json!(["ignored/**"]),
+                _ => json!("/other"),
+            };
+            let request = serde_json::from_value(value).unwrap();
+            assert!(frames.discover(request).is_err(), "{field}");
+        }
+        assert_eq!(frames.current.as_ref().unwrap().id, id);
+        assert!(frames.current.as_ref().unwrap().capture.rows.is_empty());
+    }
+    #[test]
+    fn delta_wave_is_atomic_and_new_token_or_actor_cannot_borrow_old_cells() {
+        let mut frames = DiscoveryFrames::default();
+        let (first, _) = frames.discover(frame_request(None, json!([]))).unwrap();
+        let id = first["observationFrame"].as_u64().unwrap();
+        let malformed = json!({"requirement":{"id":"bad","kind":"canonicalize","path":"/captured/bad"},"observation":{"id":"bad","status":"known","value":{"path":"relative"}}});
+        assert!(
+            frames
