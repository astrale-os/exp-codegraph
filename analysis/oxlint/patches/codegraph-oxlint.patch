+            let kind=if file_type.is_symlink() {CapturedEntryKind::Symlink} else if file_type.is_dir() {CapturedEntryKind::Directory} else if file_type.is_file() {CapturedEntryKind::File} else {CapturedEntryKind::Other};entries.push(CapturedDirectoryEntry {name,kind});
+        }
+        entries.sort_by(|a,b|a.name.cmp(&b.name));Ok(RawOwnedResult::Directory(entries))
+    },|r|match r {RawOwnedResult::Directory(e)=>Ok(e),_=>Err(io::ErrorKind::InvalidData.into())},|c|c.directory(path))
+    }
+    fn assert_observations_complete(&self) -> io::Result<()> {
+        if let Some(e) = self.failure.lock().unwrap().as_ref() {
+            return Err(io::Error::new(io::ErrorKind::InvalidData, e.clone()));
+        }
+        if self.missing.lock().unwrap().is_empty() {
+            Ok(())
+        } else {
+            Err(io::ErrorKind::WouldBlock.into())
+        }
+    }
+}
+impl ObservationCapture for TypedJournalCapture {
+    fn requirements(&self) -> Vec<Requirement> {
+        self.missing
+            .lock()
+            .unwrap()
+            .iter()
+            .enumerate()
+            .map(|(i, (kind, path, follow))| Requirement {
+                id: format!("missing:{i}"),
+                kind: kind.clone(),
+                path: path.clone(),
+                follow_links: *follow,
+            })
+            .collect()
+    }
+}
+
+/// Draft rows stay private to this stack. Only the Go-owned channel can request
+/// a replay against actual Go errors/directories or discard the entire draft.
+pub fn discover_owned_batch(
+    worker: &mut super::Worker,
+    mut request: DiscoverRequest,
+) -> Result<Value, String> {
+    use std::io::Write;
+    if request.operation != "discover-owned-batch"
+        || !request.observations.is_empty()
+        || request.observation_frame.is_some()
+    {
+        return Err("owned batch forbids client rows or frames".into());
+    }
+    let owner =
+        request.go_owner.take().ok_or("owned batch requires its private channel identity")?;
+    if !owner.is_object()
+        || owner.get("token").and_then(Value::as_str) != Some(request.token.as_str())
+    {
+        return Err("owned batch token differs".into());
+    }
+    request.operation = "discover".into();
+    let capture = Arc::new(TypedJournalCapture::new());
+    let discovered = discover_with_capture(request.clone(), capture.clone());
+    let discovery_used = capture.used.lock().unwrap().clone();
+    let mut sources = HashMap::new();
+    let draft_error = match &discovered {
+        Ok((_, Some(qualified))) => qualified
+            .paths
+            .iter()
+            .try_for_each(|path| {
+                let bytes = capture.read(path).map_err(|e| e.to_string())?;
+                let text = String::from_utf8(bytes)
+                    .map_err(|_| "original invalid UTF8 authority unavailable".to_string())?;
+                sources.insert(path.clone(), text);
+                Ok(())
+            })
+            .err(),
+        Ok(_) => Some("draft discovery lacks qualified membership".into()),
+        Err(e) => Some(e.clone()),
+    };
+    let draft_error = draft_error.or_else(|| capture.failure.lock().unwrap().clone());
+    let journal = capture.journal();
+    #[derive(Serialize)]
+    #[serde(rename_all = "camelCase")]
+    struct Draft<'a> {
+        status: &'a str,
+        owner: &'a Value,
+        engine_version: &'a str,
+        token: &'a str,
+        journal_closed: bool,
+        journal: &'a [Row],
+        draft_error: &'a Option<String>,
+        partial_directories: Vec<Value>,
+    }
+    let cell_count = journal.len();
+    let draft = Draft {
+        status: "owned-draft",
+        owner: &owner,
+        engine_version: env!("CARGO_PKG_VERSION"),
+        token: &request.token,
+        journal_closed: false,
+        journal: &journal,
+        draft_error: &draft_error,
+        partial_directories: capture.partial.lock().unwrap().clone(),
+    };
+    {
+        let mut out = io::stdout().lock();
+        serde_json::to_writer(&mut out, &draft).map_err(|e| e.to_string())?;
+        writeln!(out).map_err(|e| e.to_string())?;
+        out.flush().map_err(|e| e.to_string())?;
+    }
+    drop(draft);
+    drop(journal);
+    let mut line = String::new();
+    if io::stdin().read_line(&mut line).map_err(|e| e.to_string())? == 0 {
+        return Err("Go batch channel closed".into());
+    }
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Join {
+        operation: String,
+        owner: Value,
+        rows: Vec<Row>,
+        fallback: bool,
+    }
+    let join: Join = serde_json::from_str(&line).map_err(|e| e.to_string())?;
+    if join.operation != "reconcile" || join.owner != owner {
+        return Err("batch join changed private owner".into());
+    }
+    if join.fallback {
+        if !join.rows.is_empty() {
+            return Err("abandoned batch cannot retain staged rows".into());
+        }
+        request.operation = "discover-owned-lint".into();
+        request.go_owner = Some(owner);
+        return discover_owned_lint(worker, request);
+    }
+    if draft_error.is_some() {
+        return Err("failed native draft cannot be joined".into());
+    }
+    capture.join(join.rows)?;
+    let replay = capture.clone();
+    let (membership, qualified) = discover_with_capture(request.clone(), replay.clone())?;
+    let qualified = qualified.ok_or("batch replay lacks qualified membership")?;
+    if replay.used.lock().unwrap().clone() != discovery_used
+        || discovered.as_ref().unwrap().0 != membership
+    {
+        return Err("original batch traversal trace diverged".into());
+    }
+    let mut files = vec![];
+    for path in &qualified.paths {
+        files.push(super::InputFile {
+            path: path.clone(),
+            content: Some(sources.remove(path).ok_or("batch replay changed source identity")?),
+            handle: None,
+        });
+    }
+    if !sources.is_empty() {
+        return Err("batch retained unused source cells".into());
+    }
+    worker.memberships.retain(|_, old| old.root != request.root);
+    worker.memberships.insert(request.token.clone(), qualified);
+    let lint = super::lint(
+        worker,
+        super::Request {
+            operation: Some("lint".into()),
+            token: Some(request.token.clone()),
+            root: request.root,
+            config_path: request.config_path,
+            config: request.config,
+            config_bytes: request.config_bytes,
+            files,
+        },
+    )?;
+    Ok(
+        json!({"status":"owned-generic","owner":owner,"journalClosed":true,"journalRetained":true,"journalCount":cell_count,"token":request.token,"engineVersion":env!("CARGO_PKG_VERSION"),"membership":membership,"lint":lint,"journal":[]}),
+    )
+}
+
+#[cfg(test)]
+mod typed_owned_tests {
+    use super::*;
+    fn root() -> PathBuf {
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        static NEXT: AtomicUsize = AtomicUsize::new(0);
+        loop {
+            let path = std::env::temp_dir().join(format!(
+                "astrale-typed-owned-{}-{}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed)
+            ));
+            match std::fs::create_dir(&path) {
+                Ok(()) => return path,
+                Err(error) if error.kind() == io::ErrorKind::AlreadyExists => continue,
+                Err(error) => panic!("cannot create test root {}: {error}", path.display()),
+            }
+        }
+    }
+    #[test]
+    fn raw_cell_owns_bytes_and_borrow_cannot_replace_capture() {
+        let root = root();
+        let path = root.join("source.ts");
+        std::fs::write(&path, b"const a=1").unwrap();
+        let capture = TypedJournalCapture::new();
+        let mut borrowed = capture.read(&path).unwrap();
+        borrowed[0] = b'X';
+        std::fs::write(&path, b"const a=2").unwrap();
+        assert_eq!(capture.read(&path).unwrap(), b"const a=1");
+        let journal = capture.journal();
+        assert_eq!(journal.len(), 1);
+        assert_eq!(
+            journal[0].observation.value.as_ref().unwrap()["bytesBase64"],
+            STANDARD.encode(b"const a=1")
+        );
+        capture.join(vec![]).unwrap();
+        let hidden = root.join("newly-ignored.ts");
+        std::fs::write(&hidden, b"const ignored=1").unwrap();
+        assert_eq!(capture.read(&hidden).unwrap_err().kind(), io::ErrorKind::WouldBlock);
+        assert_eq!(capture.cells.lock().unwrap().len(), 1);
+        assert_eq!(capture.requirements()[0].path, hidden);
+        std::fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn go_failure_is_consumed_without_rewriting_native_error() {
+        let root = root();
+        let path = root.join("missing.ts");
+        let capture = TypedJournalCapture::new();
+        let native_message = capture.read(&path).unwrap_err().to_string();
+        let mut rows = capture.journal();
+        assert_eq!(rows.len(), 1);
+        let go_message = format!("open {}: no such file or directory", path.display());
+        rows[0].observation.error =
+            Some(json!({"kind":"not-found","code":"ENOENT","message":go_message}));
+        capture.join(rows).unwrap();
+        assert_eq!(capture.read(&path).unwrap_err().to_string(), go_message);
+        assert_eq!(
+            capture.journal()[0].observation.error.as_ref().unwrap()["message"],
+            native_message
+        );
+        assert_ne!(native_message, go_message);
+        std::fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn duplicate_or_invented_join_is_atomic_and_exact_closure_required() {
+        let root = root();
+        let path = root.join("missing.ts");
+        let capture = TypedJournalCapture::new();
+        let before = capture.read(&path).unwrap_err().to_string();
+        let row = capture.journal().remove(0);
+        assert!(capture.join(vec![]).is_err());
+        assert!(capture.join(vec![row.clone(), row.clone()]).is_err());
+        let mut wrong = row.clone();
+        wrong.requirement.path = root.join("unobserved.ts");
+        assert!(capture.join(vec![wrong]).is_err());
+        assert!(capture.joined.lock().unwrap().is_none());
+        assert_eq!(capture.read(&path).unwrap_err().to_string(), before);
+        let mut go = row;
+        go.observation.error =
+            Some(json!({"kind":"not-found","code":"ENOENT","message":"exact original Go outcome"}));
+        capture.join(vec![go]).unwrap();
+        assert!(capture.join(vec![]).is_err());
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
