diff --git a/capture-authority/src/lib.rs b/capture-authority/src/lib.rs
new file mode 100644
--- /dev/null
+++ b/capture-authority/src/lib.rs
@@ -0,0 +1,175 @@
+//! Generic traversal over the native service's immutable observations. Pattern
+//! parsing, VCS precedence, whitelist and ancestor pruning remain the original
+//! pinned ignore owner. This layer owns only the directory traversal request
+//! boundary, Oxlint's explicit file-extension/minified/VCS filters and link loops.
+pub use ignore::captured::{CapturedFileSystem, CapturedMetadata};
+use ignore::{WalkBuilder, overrides::OverrideBuilder};
+use std::{
+    collections::HashSet,
+    ffi::OsString,
+    io,
+    path::{Path, PathBuf},
+    sync::Arc,
+};
+
+/// The original directory entry type avoids an extra per-file stat operation.
+#[derive(Clone, Copy, Debug)]
+pub enum CapturedEntryKind {
+    File,
+    Directory,
+    Symlink,
+    Other,
+}
+#[derive(Clone, Debug)]
+pub struct CapturedDirectoryEntry {
+    pub name: OsString,
+    pub kind: CapturedEntryKind,
+}
+/// Directory membership is captured independently from metadata and read bytes.
+pub trait GenericCapture: CapturedFileSystem {
+    fn directory(&self, path: &Path) -> io::Result<Vec<CapturedDirectoryEntry>>;
+    /// Missing observations, including ones swallowed by original ignore I/O,
+    /// require another same-token capture wave, never a complete path result.
+    fn assert_observations_complete(&self) -> io::Result<()>;
+}
+
+#[derive(Debug)]
+pub struct DiscoveredMembership {
+    /// Lexical absolute identities, as returned by the original CLI walker.
+    pub paths: Vec<PathBuf>,
+    /// Captured operational failures skipped by CLI traversal. They remain seal
+    /// dependencies even when no diagnostic is emitted for them.
+    pub traversal_errors: Vec<(PathBuf, io::ErrorKind)>,
+}
+
+/// SDK invokes the CLI with exactly one directory target and explicit --config.
+/// Therefore base config ignores are applied by original LintIgnoreMatcher AFTER
+/// this function, and nested Oxlint configuration discovery is disabled.
+/// Missing reads may expand a private speculative traversal plan. No result is
+/// observable until the final completeness gate; replay starts with new matchers
+/// after each requirement wave, so cached speculative ignore answers never escape.
+/// `extensions` MUST be the engine's original LINTABLE_EXTENSIONS authority.
+pub fn discover<C: GenericCapture + 'static>(
+    capture: Arc<C>,
+    root: &Path,
+    command_ignore_patterns: &[String],
+    extensions: &[&str],
+) -> io::Result<DiscoveredMembership> {
+    if !root.is_absolute() {
+        return Err(io::Error::new(io::ErrorKind::InvalidInput, "absolute root required"));
+    }
+    let boundary = vcs_boundary(capture.as_ref(), root)?;
+    // Exact original GitignoreChecker semantics: separately reject ignored root
+    // and ignored ancestors before walking. Root itself is otherwise whitelisted.
+    let matcher_root = boundary.as_deref().unwrap_or_else(|| root.ancestors().last().unwrap());
+    let mut check_builder = WalkBuilder::new(matcher_root);
+    oxc_config::configure_walk_builder(&mut check_builder, boundary.is_some());
+    let mut check = check_builder.build_captured_matchers(capture.clone())?.remove(0);
+    let root_ignored = check.matched(root.strip_prefix(matcher_root).unwrap(), true).is_ignore();
+    if root_ignored {
+        return Ok(DiscoveredMembership { paths: vec![], traversal_errors: vec![] });
+    }
+    let mut overrides = OverrideBuilder::new(root);
+    for pattern in command_ignore_patterns {
+        overrides
+            .add(&format!("!{pattern}"))
+            .map_err(|e| io::Error::new(io::ErrorKind::InvalidInput, e))?;
+    }
+    let mut builder = WalkBuilder::new(root);
+    builder
+        .add_custom_ignore_filename(".eslintignore")
+        .overrides(overrides.build().map_err(io::Error::other)?);
+    oxc_config::configure_walk_builder(&mut builder, boundary.is_some()).follow_links(true);
+    let mut matcher = builder.build_captured_matchers(capture.clone())?.remove(0);
+    let mut result = DiscoveredMembership { paths: vec![], traversal_errors: vec![] };
+    let mut pending = vec![(root.to_path_buf(), HashSet::<PathBuf>::new())];
+    while let Some((directory, mut ancestors)) = pending.pop() {
+        let canonical = match capture.canonicalize(&directory) {
+            Ok(path) => path,
+            Err(error) => {
+                result.traversal_errors.push((directory, error.kind()));
+                continue;
+            }
+        };
+        if !ancestors.insert(canonical) {
+            continue;
+        }
+        let entries = match capture.directory(&directory) {
+            Ok(entries) => entries,
+            Err(error) => {
+                result.traversal_errors.push((directory, error.kind()));
+                continue;
+            }
+        };
+        let mut names = HashSet::new();
+        for entry in entries {
+            let name = entry.name;
+            let single = Path::new(&name);
+            if single.components().count() != 1
+                || !matches!(single.components().next(), Some(std::path::Component::Normal(_)))
+                || !names.insert(name.clone())
+            {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "invalid captured directory member",
+                ));
+            }
+            let path = directory.join(&name);
+            let metadata = match entry.kind {
+                CapturedEntryKind::Directory => {
+                    CapturedMetadata { is_dir: true, is_file: false, len: 0 }
+                }
+                CapturedEntryKind::File => {
+                    CapturedMetadata { is_dir: false, is_file: true, len: 0 }
+                }
+                CapturedEntryKind::Other => {
+                    CapturedMetadata { is_dir: false, is_file: false, len: 0 }
+                }
+                CapturedEntryKind::Symlink => match capture.metadata(&path, true) {
+                    Ok(value) => value,
+                    Err(error) => {
+                        result.traversal_errors.push((path, error.kind()));
+                        continue;
+                    }
+                },
+            };
+            if metadata.is_dir && (name == ".git" || name == ".jj") {
+                continue;
+            }
+            let ignored =
+                matcher.matched(path.strip_prefix(root).unwrap(), metadata.is_dir).is_ignore();
+            if ignored {
+                continue;
+            }
+            if metadata.is_dir {
+                pending.push((path, ancestors.clone()));
+                continue;
+            }
+            let filename = name.to_string_lossy();
+            if [".min.", "-min.", "_min."].iter().any(|part| filename.contains(part)) {
+                continue;
+            }
+            if path
+                .extension()
+                .is_some_and(|extension| extensions.iter().any(|wanted| extension == *wanted))
+            {
+                result.paths.push(path);
+            }
+        }
+    }
+    capture.assert_observations_complete()?;
+    Ok(result)
+}
+fn vcs_boundary<C: GenericCapture>(capture: &C, root: &Path) -> io::Result<Option<PathBuf>> {
+    let metadata = capture.metadata(root, true);
+    let start =
+        if metadata.is_ok_and(|m| m.is_file) { root.parent().unwrap_or(root) } else { root };
+    for path in start.ancestors() {
+        let git = capture.metadata(&path.join(".git"), true).is_ok();
+        let jj = if git { false } else { capture.metadata(&path.join(".jj"), true).is_ok() };
+        if git || jj {
+            return Ok(Some(path.to_path_buf()));
+        }
+    }
+    Ok(None)
+}
diff --git a/capture-authority/tests/discovery.rs b/capture-authority/tests/discovery.rs
new file mode 100644
--- /dev/null
+++ b/capture-authority/tests/discovery.rs
@@ -0,0 +1,271 @@
+use ignore::{WalkBuilder, overrides::OverrideBuilder};
+use oxlint_capture_authority::{
+    CapturedDirectoryEntry, CapturedEntryKind, CapturedFileSystem, CapturedMetadata,
+    GenericCapture, discover,
+};
+use std::{
+    collections::{HashMap, HashSet},
+    fs, io,
+    path::{Path, PathBuf},
+    sync::{Arc, Mutex},
+};
+#[derive(Clone, Debug)]
+enum Value {
+    Metadata(CapturedMetadata),
+    Bytes(Vec<u8>),
+    Path(PathBuf),
+    Names(Vec<CapturedDirectoryEntry>),
+    Error(io::ErrorKind),
+}
+#[derive(Debug, Default)]
+struct Capture {
+    rows: Mutex<HashMap<(String, PathBuf), Value>>,
+    missing: Mutex<HashSet<(String, PathBuf)>>,
+    replay: bool,
+}
+impl Capture {
+    fn operation(
+        &self,
+        kind: &str,
+        path: &Path,
+        read: impl FnOnce() -> io::Result<Value>,
+    ) -> io::Result<Value> {
+        let key = (kind.to_string(), path.to_path_buf());
+        if self.replay {
+            return match self.rows.lock().unwrap().get(&key).cloned() {
+                Some(Value::Error(e)) => Err(io::Error::from(e)),
+                Some(v) => Ok(v),
+                None => {
+                    self.missing.lock().unwrap().insert(key);
+                    Err(io::Error::from(io::ErrorKind::WouldBlock))
+                }
+            };
+        }
+        let result = read();
+        let value = match &result {
+            Ok(value) => value.clone(),
+            Err(e) => Value::Error(e.kind()),
+        };
+        self.rows.lock().unwrap().insert(key, value);
+        result
+    }
+    fn snapshot(&self) -> Self {
+        Self {
+            rows: Mutex::new(self.rows.lock().unwrap().clone()),
+            replay: true,
+            ..Self::default()
+        }
+    }
+}
+impl CapturedFileSystem for Capture {
+    fn metadata(&self, path: &Path, follow: bool) -> io::Result<CapturedMetadata> {
+        match self.operation(if follow { "stat" } else { "lstat" }, path, || {
+            let m = if follow { fs::metadata(path)? } else { fs::symlink_metadata(path)? };
+            Ok(Value::Metadata(CapturedMetadata {
+                is_dir: m.is_dir(),
+                is_file: m.is_file(),
+                len: m.len(),
+            }))
+        })? {
+            Value::Metadata(v) => Ok(v),
+            _ => unreachable!(),
+        }
+    }
+    fn read(&self, path: &Path) -> io::Result<Vec<u8>> {
+        match self.operation("read", path, || fs::read(path).map(Value::Bytes))? {
+            Value::Bytes(v) => Ok(v),
+            _ => unreachable!(),
+        }
+    }
+    fn canonicalize(&self, path: &Path) -> io::Result<PathBuf> {
+        match self.operation("canonicalize", path, || fs::canonicalize(path).map(Value::Path))? {
+            Value::Path(v) => Ok(v),
+            _ => unreachable!(),
+        }
+    }
+}
+impl GenericCapture for Capture {
+    fn directory(&self, path: &Path) -> io::Result<Vec<CapturedDirectoryEntry>> {
+        match self.operation("directory", path, || {
+            fs::read_dir(path)?
+                .map(|r| {
+                    r.and_then(|e| {
+                        let t = e.file_type()?;
+                        Ok(CapturedDirectoryEntry {
+                            name: e.file_name(),
+                            kind: if t.is_dir() {
+                                CapturedEntryKind::Directory
+                            } else if t.is_file() {
+                                CapturedEntryKind::File
+                            } else if t.is_symlink() {
+                                CapturedEntryKind::Symlink
+                            } else {
+                                CapturedEntryKind::Other
+                            },
+                        })
+                    })
+                })
+                .collect::<io::Result<Vec<_>>>()
+                .map(Value::Names)
+        })? {
+            Value::Names(v) => Ok(v),
+            _ => unreachable!(),
+        }
+    }
+    fn assert_observations_complete(&self) -> io::Result<()> {
+        if self.missing.lock().unwrap().is_empty() {
+            Ok(())
+        } else {
+            Err(io::Error::from(io::ErrorKind::WouldBlock))
+        }
+    }
+}
+fn put(root: &Path, path: &str, content: &str) {
+    let p = root.join(path);
+    fs::create_dir_all(p.parent().unwrap()).unwrap();
+    fs::write(p, content).unwrap();
+}
+fn baseline(root: &Path, patterns: &[String]) -> Vec<PathBuf> {
+    let boundary = oxc_config::all_paths_have_vcs_boundary(&[root.to_path_buf()], root);
+    let mut checker = oxc_config::GitignoreChecker::new();
+    if checker.is_gitignored(root, root) {
+        return vec![];
+    }
+    let mut o = OverrideBuilder::new(root);
+    for p in patterns {
+        o.add(&format!("!{p}")).unwrap();
+    }
+    let mut b = WalkBuilder::new(root);
+    b.add_custom_ignore_filename(".eslintignore").overrides(o.build().unwrap());
+    oxc_config::configure_walk_builder(&mut b, boundary).follow_links(true);
+    let mut rows: Vec<_> = b
+        .build()
+        .filter_map(Result::ok)
+        .filter_map(|e| {
+            if e.file_type().is_none_or(|t| t.is_dir()) {
+                return None;
+            }
+            let name = e.file_name().to_string_lossy();
+            if [".min.", "-min.", "_min."].iter().any(|p| name.contains(p)) {
+                return None;
+            }
+            if e.path().extension().is_some_and(|ext| ext == "ts" || ext == "js") {
+                Some(e.path().to_path_buf())
+            } else {
+                None
+            }
+        })
+        .collect();
+    rows.sort();
+    rows
+}
+fn observed(c: Arc<Capture>, root: &Path, patterns: &[String]) -> Vec<PathBuf> {
+    let mut paths = discover(c, root, patterns, &["ts", "js"]).unwrap().paths;
+    paths.sort();
+    paths
+}
+#[test]
+fn original_ignore_hierarchy_bytes_and_snapshot_remain_owned() {
+    for vcs in [false, true] {
+        let t = tempfile::tempdir().unwrap();
+        let top = t.path();
+        let root = top.join("domain");
+        fs::create_dir_all(&root).unwrap();
+        if vcs {
+            fs::create_dir(top.join(".git")).unwrap();
+            put(top, ".git/info/exclude", "domain/excluded.ts\n");
+        }
+        put(top, ".gitignore", "domain/parent-blocked.ts\n");
+        put(&root, ".gitignore", "\u{feff}blocked/\r\n!blocked/allowed.ts\r\n*.gen.ts\n[invalid\n");
+        put(&root, ".eslintignore", "eslint-blocked.ts\n!keep.gen.ts\n");
+        put(&root, "nested/.gitignore", "*.ts\n!retained.ts\n");
+        for p in [
+            "ok.ts",
+            ".hidden.ts",
+            "parent-blocked.ts",
+            "excluded.ts",
+            "blocked/allowed.ts",
+            "blocked/drop.ts",
+            "eslint-blocked.ts",
+            "generated.gen.ts",
+            "keep.gen.ts",
+            "nested/drop.ts",
+            "nested/retained.ts",
+            "dist/build.ts",
+            "test.min.js",
+            "test-min.js",
+            "test_min.js",
+            "ok.js",
+            "note.txt",
+        ] {
+            put(&root, p, "");
+        }
+        let patterns = vec!["**/dist/**".to_string()];
+        let live = Arc::new(Capture::default());
+        let actual = observed(live.clone(), &root, &patterns);
+        assert_eq!(actual, baseline(&root, &patterns));
+        let snapshot = Arc::new(live.snapshot());
+        fs::remove_dir_all(&root).unwrap();
+        assert_eq!(
+            actual,
+            observed(snapshot, &root, &patterns),
+            "replay must not touch live source or ignore files"
+        );
+    }
+}
+#[test]
+fn ignored_root_and_ancestor_cannot_be_resurrected() {
+    let t = tempfile::tempdir().unwrap();
+    let root = t.path().join("blocked/domain");
+    fs::create_dir_all(&root).unwrap();
+    put(t.path(), ".gitignore", "blocked/\n");
+    put(&root, ".gitignore", "!ok.ts\n");
+    put(&root, "ok.ts", "");
+    assert_eq!(observed(Arc::new(Capture::default()), &root, &[]), baseline(&root, &[]));
+    assert!(baseline(&root, &[]).is_empty());
+}
+#[test]
+fn missing_observation_is_a_capture_wave_never_absence() {
+    let t = tempfile::tempdir().unwrap();
+    put(t.path(), "ok.ts", "");
+    let live = Arc::new(Capture::default());
+    observed(live.clone(), t.path(), &[]);
+    let snapshot = live.snapshot();
+    snapshot.rows.lock().unwrap().remove(&("stat".to_string(), t.path().join(".gitignore")));
+    let result = discover(Arc::new(snapshot), t.path(), &[], &["ts"]);
+    assert_eq!(result.unwrap_err().kind(), io::ErrorKind::WouldBlock);
+}
+#[cfg(unix)]
+#[test]
+fn symlink_directory_alias_and_cycle_match_original_walk() {
+    use std::os::unix::fs::symlink;
+    let t = tempfile::tempdir().unwrap();
+    put(t.path(), "src/a.ts", "");
+    put(t.path(), "src/.gitignore", "drop.ts\n");
+    put(t.path(), "src/drop.ts", "");
+    symlink(t.path().join("src"), t.path().join("alias")).unwrap();
+    symlink(t.path(), t.path().join("src/loop")).unwrap();
+    let live = Arc::new(Capture::default());
+    let rows = observed(live.clone(), t.path(), &[]);
+    assert_eq!(rows, baseline(t.path(), &[]));
+    let snapshot = Arc::new(live.snapshot());
+    fs::remove_file(t.path().join("alias")).unwrap();
+    assert_eq!(rows, observed(snapshot, t.path(), &[]));
+}
+#[test]
+fn worktree_common_exclude_is_the_original_owner() {
+    let t = tempfile::tempdir().unwrap();
+    let root = t.path().join("domain");
+    fs::create_dir_all(&root).unwrap();
+    let git = t.path().join("git/worktrees/domain");
+    fs::create_dir_all(&git).unwrap();
+    put(&root, ".git", &format!("gitdir: {}\n", git.display()));
+    put(&git, "commondir", "../..\n");
+    put(&t.path().join("git"), "info/exclude", "excluded.ts\n");
+    put(&root, "ok.ts", "");
+    put(&root, "excluded.ts", "");
+    let live = Arc::new(Capture::default());
+    let actual = observed(live, &root, &[]);
+    assert_eq!(actual, baseline(&root, &[]));
+    assert_eq!(actual, vec![root.join("ok.ts")]);
+}
