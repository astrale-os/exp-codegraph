+/// The Go-owned pipe is the only transport for operation fallbacks. Source
+/// bytes, original membership and original lint share this exact generation.
+pub fn discover_owned_lint(
+    worker: &mut super::Worker,
+    mut request: DiscoverRequest,
+) -> Result<Value, String> {
+    if request.operation != "discover-owned-lint"
+        || !request.observations.is_empty()
+        || request.observation_frame.is_some()
+    {
+        return Err("owned producer forbids client rows or frames".into());
+    }
+    let owner =
+        request.go_owner.take().ok_or("owned producer requires its private channel identity")?;
+    if !owner.is_object()
+        || owner.get("token").and_then(Value::as_str) != Some(request.token.as_str())
+    {
+        return Err("owned producer token differs".into());
+    }
+    let config = request.config.clone();
+    let config_bytes = request.config_bytes.clone();
+    let config_path = request.config_path.clone();
+    let root = request.root.clone();
+    let token = request.token.clone();
+    request.operation = "discover".into();
+    let capture = Arc::new(JournalCapture {
+        capture: Mutex::new(Capture::admit(vec![])?),
+        go_owner: Some(owner.clone()),
+        failure: Mutex::new(None),
+        partial: Mutex::new(vec![]),
+    });
+    let (membership, qualified) = discover_with_capture(request, capture.clone())?;
+    let qualified = qualified.ok_or("owned discovery lacks complete membership")?;
+    let paths: Vec<_> = qualified.paths.iter().cloned().collect();
+    let mut files = Vec::new();
+    for path in &paths {
+        let raw = capture.read(path).map_err(|e| e.to_string())?;
+        // Rust UTF8 matches the original fatal UTF8 decoder with ignoreBOM=true.
+        let source =
+            String::from_utf8(raw).map_err(|_| "original invalid UTF8 authority unavailable")?;
+        files.push(super::InputFile { path: path.clone(), content: Some(source), handle: None });
+    }
+    capture.assert_observations_complete().map_err(|e| e.to_string())?;
+    worker.memberships.retain(|_, old| old.root != root);
+    worker.memberships.insert(token.clone(), qualified);
+    let lint = super::lint(
+        worker,
+        super::Request {
+            operation: Some("lint".into()),
+            token: Some(token.clone()),
+            root,
+            config_path,
+            config,
+            config_bytes,
+            files,
+        },
+    )?;
+    Ok(
+        json!({"status":"owned-generic","owner":owner,"journalClosed":true,"token":token,"engineVersion":env!("CARGO_PKG_VERSION"),"membership":membership,"lint":lint,"journal":capture.journal()}),
+    )
+}
