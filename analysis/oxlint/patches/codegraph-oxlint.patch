+/// Private measured prototype only. All original walker filesystem requests
+/// are journaled before the original stack receives their result; ordinary
+/// client observations are forbidden. These receipts have no Go authority.
+#[derive(Debug)]
+struct JournalCapture {
+    capture: Mutex<Capture>,
+    go_owner: Option<Value>,
+    failure: Mutex<Option<String>>,
+    partial: Mutex<Vec<Value>>,
+}
+impl JournalCapture {
+    fn own<T>(
+        &self,
+        kind: &str,
+        path: &Path,
+        follow: bool,
+        operation: impl FnOnce() -> io::Result<Value>,
+        borrow: impl FnOnce(&Capture) -> io::Result<T>,
+    ) -> io::Result<T> {
+        let mut capture = self.capture.lock().unwrap();
+        let key = (kind.to_owned(), path.to_path_buf(), follow);
+        if !capture.rows.contains_key(&key) {
+            let id = format!("journal:{}", capture.rows.len());
+            let observation = if self.go_owner.is_some() && kind == "directory" {
+                self.go_probe(&id, kind, path, follow, None)?
+            } else {
+                match operation() {
+                    Ok(value) => {
+                        Observation { id, status: "known".into(), value: Some(value), error: None }
+                    }
+                    Err(error) => {
+                        if self.go_owner.is_some() {
+                            self.go_probe(&id, kind, path, follow, error.raw_os_error())?
+                        } else {
+                            let kind = match error.kind() {
+                                io::ErrorKind::NotFound => "not-found",
+                                io::ErrorKind::PermissionDenied => "permission-denied",
+                                io::ErrorKind::NotADirectory => "not-directory",
+                                io::ErrorKind::InvalidData => "invalid-data",
+                                _ => "other",
+                            };
+                            Observation {
+                                id,
+                                status: "error".into(),
+                                value: None,
+                                error: Some(
+                                    json!({"kind":kind,"code":error.raw_os_error().map(|n|n.to_string()).unwrap_or_else(||"RUST_IO".into()),"message":error.to_string()}),
+                                ),
+                            }
+                        }
+                    }
+                }
+            };
+            capture.rows.insert(key, observation);
+        }
+        borrow(&capture)
+    }
+    fn go_probe(
+        &self,
+        id: &str,
+        kind: &str,
+        path: &Path,
+        follow: bool,
+        errno: Option<i32>,
+    ) -> io::Result<Observation> {
+        use std::io::Write;
+        let owner = self.go_owner.as_ref().unwrap();
+        let requirement = Requirement {
+            id: id.into(),
+            kind: kind.into(),
+            path: path.into(),
+            follow_links: follow,
+        };
+        let result = (|| -> Result<Observation, String> {
+            let frame = json!({"status":"go-probe","owner":owner,"requirement":requirement,"attemptErrno":errno,"engineVersion":env!("CARGO_PKG_VERSION")});
+            {
+                let mut out = io::stdout().lock();
+                serde_json::to_writer(&mut out, &frame).map_err(|e| e.to_string())?;
+                writeln!(out).map_err(|e| e.to_string())?;
+                out.flush().map_err(|e| e.to_string())?;
+            }
+            let mut line = String::new();
+            if io::stdin().read_line(&mut line).map_err(|e| e.to_string())? == 0 {
+                return Err("Go producer channel closed".into());
+            }
+            #[derive(Deserialize)]
+            #[serde(deny_unknown_fields)]
+            struct Response {
+                operation: String,
+                owner: Value,
+                row: Row,
+            }
+            let response: Response = serde_json::from_str(&line).map_err(|e| e.to_string())?;
+            if response.operation != "probe-result"
+                || response.owner != *owner
+                || response.row.requirement != requirement
+            {
+                return Err("Go probe changed its private owner or operation".into());
+            }
+            let admitted = Capture::admit(vec![response.row])?;
+            Ok(admitted.rows.into_values().next().unwrap())
+        })();
+        result.map_err(|e| {
+            *self.failure.lock().unwrap() = Some(e.clone());
+            io::Error::new(io::ErrorKind::InvalidData, e)
+        })
+    }
+    fn journal(&self) -> Vec<Row> {
+        let capture = self.capture.lock().unwrap();
+        let mut rows: Vec<_> = capture
+            .rows
+            .iter()
+            .map(|((kind, path, follow), o)| Row {
+                requirement: Requirement {
+                    id: o.id.clone(),
+                    kind: kind.clone(),
+                    path: path.clone(),
+                    follow_links: *follow,
+                },
+                observation: o.clone(),
+            })
+            .collect();
+        rows.sort_by(|a, b| a.requirement.cmp(&b.requirement));
+        rows
+    }
+}
