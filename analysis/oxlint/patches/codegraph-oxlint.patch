+// Native operational cells do not serialize through their own transport adapter.
+// The audit projection is produced once, after discovery/source capture. A joined
+// replay borrows immutable native successes and exact independently owned Go rows.
+type OwnedOperation = (String, PathBuf, bool);
+#[derive(Clone, Debug)]
+enum RawOwnedResult {
+    Metadata { directory: bool, file: bool, symlink: bool, length: u64 },
+    Bytes(Arc<Vec<u8>>),
+    Canonical(PathBuf),
+    Directory(Vec<CapturedDirectoryEntry>),
+    Failure { kind: io::ErrorKind, code: Option<i32>, message: String },
+}
+impl RawOwnedResult {
+    fn failure(error: io::Error) -> Self {
+        Self::Failure { kind: error.kind(), code: error.raw_os_error(), message: error.to_string() }
+    }
+    fn observation(&self, id: String) -> Observation {
+        let value = match self {
+            Self::Metadata { directory, file, symlink, length } => {
+                json!({"isDirectory":directory,"isFile":file,"isSymlink":symlink,"length":length})
+            }
+            Self::Bytes(bytes) => json!({"bytesBase64":STANDARD.encode(bytes.as_slice())}),
+            Self::Canonical(path) => json!({"path":path}),
+            Self::Directory(entries) => {
+                json!({"entries":entries.iter().map(|e|json!({"name":e.name.to_str().unwrap(),"kind":match e.kind {CapturedEntryKind::File=>"file",CapturedEntryKind::Directory=>"directory",CapturedEntryKind::Symlink=>"symlink",CapturedEntryKind::Other=>"other"}})).collect::<Vec<_>>()})
+            }
+            Self::Failure { kind, code, message } => {
+                let kind = match kind {
+                    io::ErrorKind::NotFound => "not-found",
+                    io::ErrorKind::PermissionDenied => "permission-denied",
+                    io::ErrorKind::NotADirectory => "not-directory",
+                    io::ErrorKind::InvalidData => "invalid-data",
+                    _ => "other",
+                };
+                return Observation {
+                    id,
+                    status: "error".into(),
+                    value: None,
+                    error: Some(
+                        json!({"kind":kind,"code":code.map(|n|n.to_string()).unwrap_or_else(||"RUST_IO".into()),"message":message}),
+                    ),
+                };
+            }
+        };
+        Observation { id, status: "known".into(), value: Some(value), error: None }
+    }
+    fn error(&self) -> Option<io::Error> {
+        match self {
+            Self::Failure { kind, message, .. } => Some(io::Error::new(*kind, message.clone())),
+            _ => None,
+        }
+    }
+}
+#[derive(Debug)]
+struct RawOwnedCell {
+    id: String,
+    result: RawOwnedResult,
+}
+#[derive(Debug)]
+struct TypedJournalCapture {
+    cells: Mutex<HashMap<OwnedOperation, RawOwnedCell>>,
+    used: Mutex<BTreeSet<OwnedOperation>>,
+    missing: Mutex<BTreeSet<OwnedOperation>>,
+    joined: Mutex<Option<Capture>>,
+    partial: Mutex<Vec<Value>>,
+    failure: Mutex<Option<String>>,
+}
+impl TypedJournalCapture {
+    fn new() -> Self {
+        Self {
+            cells: Mutex::new(HashMap::new()),
+            used: Mutex::new(BTreeSet::new()),
+            missing: Mutex::new(BTreeSet::new()),
+            joined: Mutex::new(None),
+            partial: Mutex::new(vec![]),
+            failure: Mutex::new(None),
+        }
+    }
+    fn call<T>(
+        &self,
+        kind: &str,
+        path: &Path,
+        follow: bool,
+        operation: impl FnOnce() -> io::Result<RawOwnedResult>,
+        native: impl FnOnce(RawOwnedResult) -> io::Result<T>,
+        go: impl FnOnce(&Capture) -> io::Result<T>,
+    ) -> io::Result<T> {
+        let key = (kind.to_owned(), path.to_path_buf(), follow);
+        self.used.lock().unwrap().insert(key.clone());
+        let joined = self.joined.lock().unwrap();
+        if let Some(go_rows) = joined.as_ref() {
+            if go_rows.rows.contains_key(&key) {
+                return go(go_rows);
+            }
+        }
+        let mut cells = self.cells.lock().unwrap();
+        if !cells.contains_key(&key) {
+            if joined.is_some() {
+                self.missing.lock().unwrap().insert(key);
+                return Err(io::ErrorKind::WouldBlock.into());
+            }
+            let id = format!("journal:{}", cells.len());
+            let result = operation().unwrap_or_else(RawOwnedResult::failure);
+            cells.insert(key.clone(), RawOwnedCell { id, result });
+        }
+        let result = cells.get(&key).unwrap().result.clone();
+        drop(cells);
+        drop(joined);
+        if let Some(error) = result.error() {
+            return Err(error);
+        }
+        native(result)
+    }
+    fn journal(&self) -> Vec<Row> {
+        let cells = self.cells.lock().unwrap();
+        let mut rows: Vec<_> = cells
+            .iter()
+            .map(|((kind, path, follow), c)| Row {
+                requirement: Requirement {
+                    id: c.id.clone(),
+                    kind: kind.clone(),
+                    path: path.clone(),
+                    follow_links: *follow,
+                },
+                observation: c.result.observation(c.id.clone()),
+            })
+            .collect();
+        rows.sort_by(|a, b| a.requirement.cmp(&b.requirement));
+        rows
+    }
+    fn join(&self, rows: Vec<Row>) -> Result<(), String> {
+        let replacements = Capture::admit(rows)?;
+        let cells = self.cells.lock().unwrap();
+        let expected: BTreeSet<_> = cells
+            .iter()
+            .filter(|(key, c)| {
+                key.0 == "directory" || matches!(c.result, RawOwnedResult::Failure { .. })
+            })
+            .map(|(key, _)| key.clone())
+            .collect();
+        if expected != replacements.rows.keys().cloned().collect() {
+            return Err("batch join lacks exact bridge operation closure".into());
+        }
+        for (key, row) in &replacements.rows {
+            let cell = cells.get(key).ok_or("batch join invented operation")?;
+            if cell.id != row.id {
+                return Err("batch join changed operation identity".into());
+            }
+        }
+        drop(cells);
+        let mut joined = self.joined.lock().unwrap();
+        if joined.is_some() {
+            return Err("batch already joined".into());
+        }
+        *joined = Some(replacements);
+        self.used.lock().unwrap().clear();
+        Ok(())
+    }
+}
