--- /dev/null
+++ b/crates/oxc_linter/examples/captured/authority.rs
@@ -0,0 +1,1475 @@
+//! Same-token captured I/O adapter for the original generic membership owner.
+use base64::{Engine, engine::general_purpose::STANDARD};
+use oxc_linter::{LINTABLE_EXTENSIONS, LintIgnoreMatcher};
+use oxlint_capture_authority::{
+    CapturedDirectoryEntry, CapturedEntryKind, CapturedFileSystem, CapturedMetadata,
+    GenericCapture, discover,
+};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use std::{
+    collections::{BTreeSet, HashMap},
+    io,
+    path::{Path, PathBuf},
+    sync::{Arc, Condvar, Mutex},
+};
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq, Ord, PartialOrd, Hash)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Requirement {
+    pub id: String,
+    pub kind: String,
+    pub path: PathBuf,
+    #[serde(default, skip_serializing_if = "is_false")]
+    pub follow_links: bool,
+}
+
+fn is_false(value: &bool) -> bool {
+    !*value
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Observation {
+    id: String,
+    status: String,
+    value: Option<Value>,
+    error: Option<Value>,
+}
+
+#[derive(Clone, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Row {
+    requirement: Requirement,
+    observation: Observation,
+}
+
+#[derive(Clone, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct DiscoverRequest {
+    operation: String,
+    pub token: String,
+    pub root: PathBuf,
+    config_path: PathBuf,
+    config: Option<Value>,
+    config_bytes: Option<Vec<u8>>,
+    command_ignore_patterns: Vec<String>,
+    observations: Vec<Row>,
+    observation_frame: Option<u64>,
+    go_owner: Option<Value>,
+}
+
+#[derive(Debug)]
+struct Capture {
+    rows: HashMap<(String, PathBuf, bool), Observation>,
+    missing: Mutex<BTreeSet<(String, PathBuf, bool)>>,
+    used: Mutex<BTreeSet<(String, PathBuf, bool)>>,
+}
+
+impl Capture {
+    fn admit(rows: Vec<Row>) -> Result<Self, String> {
+        let mut admitted = HashMap::new();
+        for row in rows {
+            let r = row.requirement;
+            let o = row.observation;
+            if r.id.is_empty()
+                || r.id != o.id
+                || !r.path.is_absolute()
+                || !matches!(
+                    r.kind.as_str(),
+                    "metadata" | "read-bytes" | "directory" | "canonicalize"
+                )
+                || !matches!(o.status.as_str(), "known" | "error")
+            {
+                return Err("invalid or unsupported same-token generic observation".into());
+            }
+            if o.status == "known" && (o.value.is_none() || o.error.is_some())
+                || o.status == "error" && (o.error.is_none() || o.value.is_some())
+            {
+                return Err("captured observation status/value conflict".into());
+            }
+            if o.status == "known" {
+                let value = o.value.as_ref().unwrap();
+                let valid = match r.kind.as_str() {
+                    "metadata" => {
+                        value.get("isDirectory").and_then(Value::as_bool).is_some()
+                            && value.get("isFile").and_then(Value::as_bool).is_some()
+                            && value.get("isSymlink").and_then(Value::as_bool).is_some()
+                            && value.get("length").and_then(Value::as_u64).is_some()
+                    }
+                    "canonicalize" => value
+                        .get("path")
+                        .and_then(Value::as_str)
+                        .is_some_and(|p| Path::new(p).is_absolute()),
+                    "read-bytes" => value
+                        .get("bytesBase64")
+                        .and_then(Value::as_str)
+                        .is_some_and(|b| STANDARD.decode(b).is_ok()),
+                    "directory" => {
+                        value.get("entries").and_then(Value::as_array).is_some_and(|entries| {
+                            let mut seen = BTreeSet::new();
+                            entries.iter().all(|entry| {
+                                let Some(name) = entry.get("name").and_then(Value::as_str) else {
+                                    return false;
+                                };
+                                let mut components = Path::new(name).components();
+                                matches!(components.next(), Some(std::path::Component::Normal(_)))
+                                    && components.next().is_none()
+                                    && seen.insert(name)
+                                    && entry.get("kind").and_then(Value::as_str).is_some_and(
+                                        |kind| {
+                                            matches!(
+                                                kind,
+                                                "file" | "directory" | "symlink" | "other"
+                                            )
+                                        },
+                                    )
+                            })
+                        })
+                    }
+                    _ => false,
+                };
+                if !valid {
+                    return Err("malformed captured generic value is not an I/O failure".into());
+                }
+            } else {
+                let error = o.error.as_ref().unwrap();
+                if !error.get("kind").and_then(Value::as_str).is_some_and(|k| {
+                    matches!(
+                        k,
+                        "not-found"
+                            | "permission-denied"
+                            | "not-directory"
+                            | "loop"
+                            | "invalid-data"
+                            | "other"
+                    )
+                }) || error.get("code").and_then(Value::as_str).is_none()
+                    || error.get("message").and_then(Value::as_str).is_none()
+                {
+                    return Err("malformed captured operational failure".into());
+                }
+            }
+            let key = (r.kind, r.path, r.follow_links);
+            if admitted.insert(key, o).is_some() {
+                return Err("duplicate captured generic operation".into());
+            }
+        }
+        Ok(Self {
+            rows: admitted,
+            missing: Mutex::new(BTreeSet::new()),
+            used: Mutex::new(BTreeSet::new()),
+        })
+    }
+
+    fn value(&self, kind: &str, path: &Path, follow: bool) -> io::Result<Value> {
+        let key = (kind.to_owned(), path.to_path_buf(), follow);
+        self.used.lock().unwrap().insert(key.clone());
+        let Some(row) = self.rows.get(&key) else {
+            self.missing.lock().unwrap().insert(key);
+            return Err(io::ErrorKind::WouldBlock.into());
+        };
+        if row.status == "error" {
+            let error = row.error.as_ref().unwrap();
+            let kind = match error.get("kind").and_then(Value::as_str) {
+                Some("not-found") => io::ErrorKind::NotFound,
+                Some("permission-denied") => io::ErrorKind::PermissionDenied,
+                Some("not-directory") => io::ErrorKind::NotADirectory,
+                Some("invalid-data") => io::ErrorKind::InvalidData,
+                _ => io::ErrorKind::Other,
+            };
+            let message =
+                error.get("message").and_then(Value::as_str).unwrap_or("captured I/O failure");
+            return Err(io::Error::new(kind, message.to_owned()));
+        }
+        Ok(row.value.as_ref().unwrap().clone())
+    }
+
+    fn requirements(&self) -> Vec<Requirement> {
+        self.missing
+            .lock()
+            .unwrap()
+            .iter()
+            .enumerate()
+            .map(|(i, (kind, path, follow))| Requirement {
+                id: format!("generic:{i}"),
+                kind: kind.clone(),
+                path: path.clone(),
+                follow_links: *follow,
+            })
+            .collect()
+    }
+}
+
+impl CapturedFileSystem for Capture {
+    fn metadata(&self, path: &Path, follow: bool) -> io::Result<CapturedMetadata> {
+        let value = self.value("metadata", path, follow)?;
+        let parse = || {
+            Some(CapturedMetadata {
+                is_dir: value.get("isDirectory")?.as_bool()?,
+                is_file: value.get("isFile")?.as_bool()?,
+                len: value.get("length")?.as_u64()?,
+            })
+        };
+        parse()
+            .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidData, "invalid captured metadata"))
+    }
+    fn read(&self, path: &Path) -> io::Result<Vec<u8>> {
+        let value = self.value("read-bytes", path, false)?;
+        let bytes = value.get("bytesBase64").and_then(Value::as_str).ok_or_else(|| {
+            io::Error::new(io::ErrorKind::InvalidData, "invalid captured byte value")
+        })?;
+        STANDARD.decode(bytes).map_err(|e| io::Error::new(io::ErrorKind::InvalidData, e))
+    }
+    fn canonicalize(&self, path: &Path) -> io::Result<PathBuf> {
+        let value = self.value("canonicalize", path, false)?;
+        let path = value
+            .get("path")
+            .and_then(Value::as_str)
+            .map(PathBuf::from)
+            .filter(|p| p.is_absolute())
+            .ok_or_else(|| {
+                io::Error::new(io::ErrorKind::InvalidData, "invalid captured canonical identity")
+            })?;
+        Ok(path)
+    }
+}
+
+impl GenericCapture for Capture {
+    fn directory(&self, path: &Path) -> io::Result<Vec<CapturedDirectoryEntry>> {
+        let value = self.value("directory", path, false)?;
+        let entries = value.get("entries").and_then(Value::as_array).ok_or_else(|| {
+            io::Error::new(io::ErrorKind::InvalidData, "invalid captured directory")
+        })?;
+        entries
+            .iter()
+            .map(|e| {
+                let name = e.get("name").and_then(Value::as_str).ok_or_else(|| {
+                    io::Error::new(io::ErrorKind::InvalidData, "invalid captured directory name")
+                })?;
+                let kind = match e.get("kind").and_then(Value::as_str) {
+                    Some("file") => CapturedEntryKind::File,
+                    Some("directory") => CapturedEntryKind::Directory,
+                    Some("symlink") => CapturedEntryKind::Symlink,
+                    Some("other") => CapturedEntryKind::Other,
+                    _ => {
+                        return Err(io::Error::new(
+                            io::ErrorKind::InvalidData,
+                            "invalid captured directory entry kind",
+                        ));
+                    }
+                };
+                Ok(CapturedDirectoryEntry { name: name.into(), kind })
+            })
+            .collect()
+    }
+    fn assert_observations_complete(&self) -> io::Result<()> {
+        if self.missing.lock().unwrap().is_empty() {
+            Ok(())
+        } else {
+            Err(io::ErrorKind::WouldBlock.into())
+        }
+    }
+}
+
+trait ObservationCapture: GenericCapture {
+    fn requirements(&self) -> Vec<Requirement>;
+}
+impl ObservationCapture for Capture {
+    fn requirements(&self) -> Vec<Requirement> {
+        Capture::requirements(self)
+    }
+}
+
+pub struct MembershipOwner {
+    pub root: PathBuf,
+    pub config_key: (PathBuf, Value),
+    pub paths: BTreeSet<PathBuf>,
+}
+
+#[derive(Default)]
+pub struct DiscoveryFrames {
+    current: Option<DiscoveryFrame>,
+    next: u64,
+}
+struct DiscoveryFrame {
+    id: u64,
+    token: String,
+    root: PathBuf,
+    config_path: PathBuf,
+    config: Option<Value>,
+    config_bytes: Option<Vec<u8>>,
+    command_ignore_patterns: Vec<String>,
+    capture: Arc<Capture>,
+}
+impl DiscoveryFrames {
+    pub fn discover(
+        &mut self,
+        mut request: DiscoverRequest,
+    ) -> Result<(Value, Option<MembershipOwner>), String> {
+        if request.operation != "discover"
+            || request.token.is_empty()
+            || !request.root.is_absolute()
+        {
+            return Err("discovery requires an absolute root and captured token".into());
+        }
+        let (configuration, _) = super::parse_configuration(
+            &request.config_path,
+            request.config.clone(),
+            request.config_bytes.clone(),
+        )?;
+        super::admit_configuration(&configuration)?;
+        // Validate the complete delta before changing any retained cell. A frame
+        // owns exactly one actor/token/root/configuration/ignore operation stream.
+        let delta = Capture::admit(std::mem::take(&mut request.observations))?;
+        if let Some(id) = request.observation_frame {
+            let frame = self.current.as_mut().ok_or("unknown discovery observation frame")?;
+            if frame.id != id
+                || frame.token != request.token
+                || frame.root != request.root
+                || frame.config_path != request.config_path
+                || frame.config != request.config
+                || frame.config_bytes != request.config_bytes
+                || frame.command_ignore_patterns != request.command_ignore_patterns
+            {
+                return Err(
+                    "discovery frame changed its token/root/configuration/ignore owner".into()
+                );
+            }
+            if delta.rows.keys().any(|key| frame.capture.rows.contains_key(key)) {
+                return Err("discovery delta repeats an already owned observation".into());
+            }
+            let capture =
+                Arc::get_mut(&mut frame.capture).ok_or("discovery capture still has a borrower")?;
+            capture.rows.extend(delta.rows);
+            capture.missing.get_mut().unwrap().clear();
+        } else {
+            self.current = Some(DiscoveryFrame {
+                id: 0,
+                token: request.token.clone(),
+                root: request.root.clone(),
+                config_path: request.config_path.clone(),
+                config: request.config.clone(),
+                config_bytes: request.config_bytes.clone(),
+                command_ignore_patterns: request.command_ignore_patterns.clone(),
+                capture: Arc::new(delta),
+            });
+        }
+        let frame = self.current.as_mut().unwrap();
+        let (mut result, membership) = discover_with_capture(request, frame.capture.clone())?;
+        self.next = self.next.checked_add(1).ok_or("discovery frame sequence exhausted")?;
+        if self.next > 9_007_199_254_740_991 {
+            return Err("discovery frame exceeds JSON integer authority".into());
+        }
+        frame.id = self.next;
+        result["observationFrame"] = json!(frame.id);
+        Ok((result, membership))
+    }
+}
+
+pub fn discover_owned(
+    mut request: DiscoverRequest,
+) -> Result<(Value, Option<MembershipOwner>), String> {
+    if request.observation_frame.is_some() {
+        return Err("standalone discovery cannot borrow an actor frame".into());
+    }
+    let capture = Arc::new(Capture::admit(std::mem::take(&mut request.observations))?);
+    discover_with_capture(request, capture)
+}
+fn discover_with_capture(
+    request: DiscoverRequest,
+    capture: Arc<impl ObservationCapture + 'static>,
+) -> Result<(Value, Option<MembershipOwner>), String> {
+    if request.operation != "discover" || request.token.is_empty() || !request.root.is_absolute() {
+        return Err("discovery requires an absolute root and captured token".into());
+    }
+    let (config, config_input) =
+        super::parse_configuration(&request.config_path, request.config, request.config_bytes)?;
+    // Configuration capability is identical to the actual builtin lint runtime.
+    super::admit_configuration(&config)?;
+    let baseline = capture.metadata(&request.root.join("oxlint-suppressions.json"), true);
+    if capture.assert_observations_complete().is_ok() && baseline.is_ok() {
+        return Ok((
+            json!({"status":"residual", "token":request.token,
+            "engineVersion":env!("CARGO_PKG_VERSION"),
+            "residual":["Positive suppression baseline requires its original captured parser/diff owner."]}),
+            None,
+        ));
+    }
+    let discovered = discover(
+        capture.clone(),
+        &request.root,
+        &request.command_ignore_patterns,
+        LINTABLE_EXTENSIONS,
+    );
+    let missing = capture.requirements();
+    if !missing.is_empty() {
+        return Ok((
+            json!({"status":"requirements", "token":request.token,
+            "engineVersion":env!("CARGO_PKG_VERSION"), "requirements":missing}),
+            None,
+        ));
+    }
+    let discovered = discovered.map_err(|e| format!("captured generic discovery failed: {e}"))?;
+    let matcher = LintIgnoreMatcher::new(&config.ignore_patterns, config.dir().unwrap(), vec![]);
+    let paths: Vec<_> =
+        discovered.paths.into_iter().filter(|p| !matcher.should_ignore(p)).collect();
+    let owner = MembershipOwner {
+        root: request.root.clone(),
+        config_key: (request.config_path, config_input),
+        paths: paths.iter().cloned().collect(),
+    };
+    if owner.paths.len() != paths.len() {
+        return Err("generic traversal returned duplicate lexical source identity".into());
+    }
+    Ok((
+        json!({"status":"membership", "token":request.token, "root":request.root,
+        "engineVersion":env!("CARGO_PKG_VERSION"), "membershipQualified":true,
+        "paths":paths, "traversalErrors":discovered.traversal_errors.iter().map(|(p,k)|json!({"path":p,"kind":format!("{k:?}")})).collect::<Vec<_>>() }),
+        Some(owner),
+    ))
+}
+
+/// Bounded private experiment: unavailable I/O suspends the actual original
+/// stack. Original matcher caches never receive a speculative absence/error.
+#[derive(Default)]
+pub struct SuspendedDiscovery {
+    current: Option<SuspendedFrame>,
+    next: u64,
+}
+struct SuspendedFrame {
+    id: u64,
+    identity: Value,
+    capture: Arc<SuspendedCapture>,
+    thread: Option<std::thread::JoinHandle<()>>,
+}
+struct SuspendedState {
+    capture: Capture,
+    cancelled: bool,
+    completed: Option<Result<(Value, Option<MembershipOwner>), String>>,
+}
+struct SuspendedCapture {
+    state: Mutex<SuspendedState>,
+    wake: Condvar,
+}
+impl std::fmt::Debug for SuspendedCapture {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("SuspendedCapture")
+    }
+}
+impl SuspendedCapture {
+    fn call<T>(&self, mut operation: impl FnMut(&Capture) -> io::Result<T>) -> io::Result<T> {
+        let mut state = self.state.lock().unwrap();
+        loop {
+            if state.cancelled {
+                return Err(io::ErrorKind::Interrupted.into());
+            }
+            match operation(&state.capture) {
+                Err(error) if error.kind() == io::ErrorKind::WouldBlock => {
+                    self.wake.notify_all();
+                    state = self.wake.wait(state).unwrap();
+                }
+                result => return result,
+            }
+        }
+    }
+}
+impl CapturedFileSystem for SuspendedCapture {
+    fn metadata(&self, path: &Path, follow: bool) -> io::Result<CapturedMetadata> {
+        self.call(|c| c.metadata(path, follow))
+    }
+    fn read(&self, path: &Path) -> io::Result<Vec<u8>> {
+        self.call(|c| c.read(path))
+    }
+    fn canonicalize(&self, path: &Path) -> io::Result<PathBuf> {
+        self.call(|c| c.canonicalize(path))
+    }
+}
+impl GenericCapture for SuspendedCapture {
+    fn directory(&self, path: &Path) -> io::Result<Vec<CapturedDirectoryEntry>> {
+        self.call(|c| c.directory(path))
+    }
+    fn assert_observations_complete(&self) -> io::Result<()> {
+        self.call(|c| c.assert_observations_complete())
+    }
+}
+impl ObservationCapture for SuspendedCapture {
+    fn requirements(&self) -> Vec<Requirement> {
+        // An unowned operation cannot return to the original stack. Only the
+        // ordered actor's polling side can observe its suspended requirements.
+        vec![]
+    }
+}
+impl Drop for SuspendedFrame {
+    fn drop(&mut self) {
+        {
+            let mut state = self.capture.state.lock().unwrap();
+            state.cancelled = true;
+            self.capture.wake.notify_all();
+        }
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+    }
+}
+impl SuspendedDiscovery {
+    pub fn discover(
+        &mut self,
+        mut request: DiscoverRequest,
+    ) -> Result<(Value, Option<MembershipOwner>), String> {
+        if request.operation != "discover-suspend"
+            || request.token.is_empty()
+            || !request.root.is_absolute()
+        {
+            return Err("invalid suspended discovery owner".into());
+        }
+        let identity = json!({"token":request.token,"root":request.root,"configPath":request.config_path,"config":request.config,"configBytes":request.config_bytes,"commandIgnorePatterns":request.command_ignore_patterns});
+        let delta = Capture::admit(std::mem::take(&mut request.observations))?;
+        if let Some(id) = request.observation_frame {
+            let frame = self.current.as_ref().ok_or("unknown suspended frame")?;
+            if id == 0 || frame.id != id || frame.identity != identity {
+                return Err(
+                    "suspended frame changed its token/root/configuration/ignore owner".into()
+                );
+            }
+            let mut state = frame.capture.state.lock().unwrap();
+            if delta.rows.keys().any(|key| state.capture.rows.contains_key(key)) {
+                return Err("suspended delta repeats owned observation".into());
+            }
+            state.capture.rows.extend(delta.rows);
+            state.capture.missing.get_mut().unwrap().clear();
+            frame.capture.wake.notify_all();
+        } else {
+            self.current = None;
+            let (config, _) = super::parse_configuration(
+                &request.config_path,
+                request.config.clone(),
+                request.config_bytes.clone(),
+            )?;
+            super::admit_configuration(&config)?;
+            let capture = Arc::new(SuspendedCapture {
+                state: Mutex::new(SuspendedState {
+                    capture: delta,
+                    cancelled: false,
+                    completed: None,
+                }),
+                wake: Condvar::new(),
+            });
+            let thread_capture = capture.clone();
+            request.operation = "discover".into();
+            let thread = std::thread::spawn(move || {
+                let completed = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    discover_with_capture(request, thread_capture.clone())
+                }))
+                .unwrap_or_else(|_| Err("suspended original discovery panicked".into()));
+                let mut state = thread_capture.state.lock().unwrap();
+                state.completed = Some(completed);
+                thread_capture.wake.notify_all();
+            });
+            self.current = Some(SuspendedFrame { id: 0, identity, capture, thread: Some(thread) });
+        }
+        let frame = self.current.as_mut().unwrap();
+        let mut state = frame.capture.state.lock().unwrap();
+        let (mut result, membership) = loop {
+            if let Some(completed) = state.completed.take() {
+                break completed?;
+            }
+            let requirements = state.capture.requirements();
+            if !requirements.is_empty() {
+                break (
+                    json!({"status":"requirements","token":frame.identity["token"],"engineVersion":env!("CARGO_PKG_VERSION"),"requirements":requirements}),
+                    None,
+                );
+            }
+            state = frame.capture.wake.wait(state).unwrap();
+        };
+        self.next = self.next.checked_add(1).ok_or("suspended frame sequence exhausted")?;
+        frame.id = self.next;
+        result["observationFrame"] = json!(frame.id);
+        Ok((result, membership))
+    }
+}
