{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@fixture/sdk": ["./src/sdk/index.ts"],
      "@fixture/referenced": ["./packages/referenced/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "./packages/referenced" }]
}
