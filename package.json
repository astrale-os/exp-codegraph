{
  "name": "@astrale-os/codegraph",
  "version": "0.1.1",
  "private": false,
  "description": "Headless TypeScript code graph, specification conformance engine, and developer tooling",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrale-os/exp-codegraph.git"
  },
  "bin": {
    "cg": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "native-release.json",
    "native-artifacts",
    "*.ts",
    "analysis",
    "application",
    "cache",
    "conformance",
    "markdown",
    "reference",
    "repository",
    "schema",
    "server",
    "source",
    "specification",
    "api",
    "authoring",
    "compiler",
    "json-schema",
    "typescript",
    "viewer",
    "viewer-host",
    "workspace",
    "!dist/**/*.map",
    "!analysis/typescript/native/**",
    "!analysis/typescript/ttsc/**",
    "!analysis/oxlint/**"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./authoring": {
      "types": "./dist/authoring/index.d.ts",
      "import": "./dist/authoring/index.js"
    },
    "./analysis": {
      "types": "./dist/analysis/index.d.ts",
      "import": "./dist/analysis/index.js"
    },
    "./analysis/typescript": {
      "types": "./dist/analysis/typescript/index.d.ts",
      "import": "./dist/analysis/typescript/index.js"
    },
    "./analysis/sqlite": {
      "types": "./dist/analysis/sqlite/index.d.ts",
      "import": "./dist/analysis/sqlite/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    },
    "./repository": {
      "types": "./dist/repository/index.d.ts",
      "import": "./dist/repository/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./specification": {
      "types": "./dist/specification/index.d.ts",
      "import": "./dist/specification/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js"
    },
    "./package.json": "./package.json",
    "./analysis/native": {
      "types": "./dist/analysis/native/index.d.ts",
      "import": "./dist/analysis/native/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "executableFiles": [
      "./native-artifacts/darwin-arm64/bin/codegraph-native",
      "./native-artifacts/darwin-arm64/bin/codegraph-oxlint",
      "./native-artifacts/darwin-x64/bin/codegraph-native",
      "./native-artifacts/linux-arm64/bin/codegraph-native",
      "./native-artifacts/linux-x64/bin/codegraph-native",
      "./native-artifacts/linux-x64/bin/codegraph-oxlint",
      "./native-artifacts/win32-x64/bin/codegraph-native.exe"
    ]
  },
  "preferUnplugged": true,
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsgo -p tsconfig.build.json",
    "clean": "node scripts/clean-dist.mjs",
    "check": "node scripts/check.ts",
    "dev": "node cli.ts dev .",
    "release:check": "pnpm run native:assert-release && pnpm run typecheck && pnpm run test",
    "artifact:policy": "vitest run __tests__/npm-distribution-policy.test.ts",
    "native:test": "node scripts/native/test.mjs",
    "native:build": "node scripts/native/build.mjs",
    "native:assemble": "node scripts/native/assemble.mjs",
    "native:assert-release": "node scripts/native/assert-release.mjs",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p __tests__/typecheck/tsconfig.json && tsgo --noEmit -p qualification/v2/application/tsconfig.json && tsgo --noEmit -p qualification/v2/extension/tsconfig.json && tsgo --noEmit -p qualification/v2/experiments/tsconfig.json && tsgo --noEmit -p qualification/v2/maintainability/tsconfig.json && tsgo --noEmit -p qualification/v2/performance/tsconfig.json && tsgo --noEmit -p qualification/v2/self-host/tsconfig.json && tsgo --noEmit -p qualification/v2/structural/tsconfig.json",
    "test": "pnpm run build && vitest run --testTimeout 60000 --maxWorkers 1",
    "test:file": "pnpm run build && vitest run --testTimeout 15000 --maxWorkers 2",
    "test:watch": "vitest --testTimeout 15000 --maxWorkers 2",
    "qualify:cli-restart": "node qualification/v2/application/cli-restart.ts",
    "native:admit-packages": "node scripts/native/admit-packages.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "ajv": "^8.20.0",
    "github-slugger": "^2.0.0",
    "katex": "^0.18.1",
    "mdast-util-from-markdown": "^2.0.2",
    "mermaid": "^11.16.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "preact": "^10.29.7",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrale/typescript-config": "jsr:~1.1.3",
    "@types/node": "^24.10.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "ttsc": "0.25.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.13 <23 || >=24 <25 || >=26 <27"
  },
  "packageManager": "pnpm@11.13.1"
}
